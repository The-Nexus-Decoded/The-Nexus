{
  "name": "souldrifter-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser-native isometric SoulDrifter RPG prototype.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/clean-build.mjs && tsc -b && vite build && node scripts/prepare-sites-build.mjs && node scripts/prune-runtime-assets.mjs",
    "optimize:dungeon-kit": "python scripts/optimize-dungeon-kit.py",
    "check:dungeon-kit": "python scripts/optimize-dungeon-kit.py --check",
    "check:flatmap": "python scripts/maps/make_breach_v2_flatmap.py --check",
    "verify:release": "node scripts/verify-release-targets.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.4.2",
    "@types/three": "^0.185.4",
    "happy-dom": "20.11.13",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "three": "^0.185.1"
  }
}
