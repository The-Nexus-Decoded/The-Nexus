  "firstBreach": {
    "galleryCountMin": 3,
    "galleryCountMax": 5,
    "comparisonSeed": 4182,
    "requiredPaths": ["wayfarer", "oathbreaker"],
    "permanentRegressionCases": [
      "route_gate_open_but_wall_intact_behind_gate",
