{
  "schemaVersion": 3,
  "policyId": "universal-procedural-level-topology-v3",
  "architecture": "LOGICAL_GRAPH_THEN_TRAVERSAL_CONTRACTS_THEN_CONSTRUCTIVE_EMBEDDING_THEN_CANONICAL_BOUNDARIES_SURFACES_AND_VOLUMES_THEN_RUNTIME",
  "relatedPolicies": [
    "SPATIAL_CONNECTION_TRAVERSAL_CATALOG.md",
    "config/spatial-connection-policy.json",
    "templates/spatial-connection-record.template.json"
  ],
  "requiredLayers": [
    "logical_graph",
    "traversal_connection_contracts",
    "embedded_spatial_plan_surfaces_and_volumes",
    "runtime_geometry_physics_navigation_and_controller_states"
  ],
  "supportedSpatialNodeFamilies": [
    "ENCLOSED_ARCHITECTURAL_SPACE",
    "CAVERN_OR_SHAFT",
    "VERTICAL_TRAVERSAL_REGION",
    "WATER_OR_AIR_VOLUME",
    "BIOME_POCKET",
    "LABYRINTH_OR_MEGA_ZONE",
    "DYNAMIC_OR_LIVING_REGION",
    "EXTERIOR_OR_STREAMED_REGION",
    "VEHICLE_OR_TRANSPORT_SPACE"
  ],
  "constructiveEmbedding": {
    "placeDestinationRelativeToAcceptedEdge": true,
    "resolveEdgeBeforeAcceptingDestination": true,
    "deriveDestinationTransformFromConnection": true,
    "validateMovementCameraResourcesHazardsAndRecovery": true,
    "retryAlternateSocketSurfaceVolumeOrientationOrModule": true,
    "backtrackWhenNecessary": true,
    "rejectWhenBacktrackingExhausted": true,
    "deterministicSeedsSupported": true
  },
  "connectionCatalog": "config/spatial-connection-policy.json",
  "canonicalOwnershipRules": {
    "sharedBoundaryEmittedOnce": true,
    "openSpanBlockingBoundary": false,
    "controlledThresholdOwnsSingleApertureStateCollisionContract": true,
    "physicalConnectorMustReachBothEndpoints": true,
    "coincidentDuplicateBoundariesAllowed": false,
    "deterministicSurfaceAndVolumeOwnershipRequired": true,
    "waterAndAirVolumesMayTrapPlayer": false,
    "runtimeConsumesAcceptedInventory": true
  },
  "runtimeSpatialAuthority": {
    "required": true,
    "authorityIdRequired": true,
    "stateRevisionRequired": true,
    "requiredSourceCoverage": [
      "STRUCTURAL_SHELL",
      "OPENINGS_AND_APERTURES",
      "WALKABLE_AND_NONWALKABLE_SURFACES",
      "TERRAIN_AND_ELEVATION_TRANSITIONS",
      "THRESHOLDS_AND_MOVING_LEAVES",
      "PROPS_LANDMARKS_AND_BUILT_INS",
      "HAZARDS_AND_SPECIAL_VOLUMES",
      "DYNAMIC_AND_LIFECYCLE_STATES"
    ],
    "requiredConsumers": [
      "PLAYER_MOVEMENT",
      "NPC_NAVIGATION",
      "LINE_OF_SIGHT_AND_OCCLUSION",
      "PROJECTILE_MELEE_AND_PHYSICS",
      "INTERACTION",
      "CAMERA",
      "DEBUG_AND_PROOF_HOOKS"
    ],
    "requiredStateCoverage": [
      "INTACT",
      "DAMAGED",
      "DESTROYED",
      "ENABLED",
      "DISABLED",
      "OPEN",
      "CLOSED",
      "REMOVED"
    ],
    "sameLiveAuthorityAndStateRevisionForAllConsumers": true,
    "debugAndProofHooksMayUseReducedAuthority": false,
    "stableObjectRenderOwnerColliderIdsRequired": true,
    "allowedParticipationClassifications": [
      "BLOCKING",
      "NONBLOCKING",
      "TRAVERSABLE",
      "VFX_ONLY",
      "INHERITED_FROM_RENDER_OWNER"
    ],
    "querySpecificParticipationMustBeExplicit": true,
    "dynamicStatePropagationRequired": true
  },
  "objectContractReconciliation": {
    "requiredChain": [
      "ASSET_CATALOG",
      "PLACEMENT_REGISTRY",
      "GENERATED_OR_AUTHORED_LAYOUT",
      "RUNTIME_EFFECTIVE_OBJECT",
      "RENDER_OWNER",
      "COLLIDER_INSTANCES"
    ],
    "requiredReconciledFields": [
      "ASSET_ID",
      "OBJECT_ID",
      "WORLD_TRANSFORM",
      "POST_FIT_WORLD_BOUNDS",
      "COLLISION_PROFILE",
      "QUERY_PARTICIPATION",
      "DYNAMIC_STATE"
    ],
    "renderedSolidRequiresColliderOrExplicitParticipationClassification": true,
    "colliderOnlyObjectRequiresReason": true,
    "approvedOverrideRequiredForContractDrift": true,
    "requiredOverrideFields": [
      "FIELD",
      "PRIOR_VALUE",
      "EFFECTIVE_VALUE",
      "REASON",
      "TICKET_ID",
      "APPROVED_BY",
      "APPROVAL_EVIDENCE"
    ]
  },
  "postFitProxyValidation": {
    "finalWorldTransformRequired": true,
    "postFitWorldBoundsRequired": true,
    "finalProxyBoundsRequired": true,
    "renderOwnerBoundsComparedToProxyBounds": true,
    "preFitOrLocalBoundsMaySubstitute": false,
    "mismatchBlocksAcceptance": true
  },
  "productionMovementProof": {
    "productionMovementPrimitiveRequired": true,
    "productionBodyProfileRequired": true,
    "productionTimestepRequired": true,
    "requiredCases": [
      "AXIS_ALIGNED",
      "DIAGONAL_COMBINED_INPUT",
      "CORNER_APPROACH",
      "WALL_SLIDING"
    ],
    "continuousSegmentOrSweepProofRequired": true,
    "endpointOnlyProofSufficient": false,
    "gridOnlyProofSufficient": false,
    "pathOnlyProofSufficient": false,
    "sparseSampleProofSufficient": false
  },
  "diagnosticGate": {
    "derivedFromActualEmbeddedGeometryVolumesAndStates": true,
    "requiredBeforeDressing": true,
    "horizontalRequires": ["TOP_DOWN_PLAN"],
    "verticalRequires": ["TOP_DOWN_PLAN", "SECTION_OR_ELEVATION"],
    "aquaticRequires": ["TOP_DOWN_PLAN", "SECTION_OR_ELEVATION", "THREE_D_VOLUME_OR_SLICE"],
    "dynamicRequires": ["STATE_GRAPH", "TIMELINE_OR_STATE_SEQUENCE", "BEFORE_AFTER_GEOMETRY"],
    "megaZoneRequires": ["REGION_GRAPH", "STREAMING_MAP", "LOCAL_SUBGRAPHS"],
    "automatedTopologyReview": true,
    "independentAiVisionReviewWhenApplicable": true,
    "ownerReviewForInitialOrMajorGeneratorChange": true
  },
  "defaultHardInvariants": {
    "requiredLogicalEdgesEqualsPhysicallyOrExplicitlyResolvedEdges": true,
    "unintendedNodeOverlaps": 0,
    "unintendedConnectorNodeOverlaps": 0,
    "coincidentDuplicateBoundaries": 0,
    "boundariesCrossingOpenings": 0,
    "orphanDoorsGatesOrConnectors": 0,
    "unmatchedConnectorEndpoints": 0,
    "physicalConnectorsEndingAtBlockingGeometry": 0,
    "missingDestinationOpenings": 0,
    "clearanceFailures": 0,
    "surfaceContinuityFailures": 0,
    "volumeContinuityFailures": 0,
    "collisionContinuityFailures": 0,
    "navigationContinuityFailures": 0,
    "unsupportedElevationOrDepthTransitions": 0,
    "movementStateTransitionFailures": 0,
    "resourceRuleFailures": 0,
    "recoveryOrSoftLockFailures": 0
  },
  "hardZeroMetrics": {
    "proofSourceCoverageFailures": 0,
    "unresolvedRenderOnlySolids": 0,
    "unexplainedColliderOnlyObjects": 0,
    "catalogRegistryContractDrift": 0,
    "registryGeneratedContractDrift": 0,
    "generatedRuntimeContractDrift": 0,
    "runtimeRenderColliderContractDrift": 0,
    "unjustifiedContractOverrides": 0,
    "postFitProxyMismatchFailures": 0,
    "spatialQueryParityFailures": 0,
    "spatialStatePropagationFailures": 0,
    "lineOfSightParityFailures": 0,
    "projectilePhysicsParityFailures": 0,
    "interactionParityFailures": 0,
    "cameraParityFailures": 0,
    "movementPrimitiveParityFailures": 0,
    "diagonalNavigationFailures": 0,
    "continuousSegmentOrSweepFailures": 0
  },
  "runtimeProof": {
    "realMovementModeRequiredForEveryEdge": true,
    "debugWarpMayProveConnectivity": false,
    "sourceTransitionDestinationEvidence": true,
    "controlledConnectionStatesEvidence": true,
    "saveReloadProofWhenMidTraversalPersistenceIsPossible": true,
    "independentVerification": true
  }
}
